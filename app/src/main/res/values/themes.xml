<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Pre-Compose window dressing. The app is dark-only, so this paints the launch window in the
        same ground colour the Compose theme uses; without it a cold start flashes white.
    -->
    <style name="Theme.InstaVisionSDKSample" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
